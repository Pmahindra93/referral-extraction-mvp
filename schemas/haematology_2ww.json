{
  "name": "haematology_2ww",
  "display_name": "Haematology 2WW referral",
  "document_description": "a GP referral letter for the urgent suspected-cancer (two-week-wait) haematology pathway",
  "domain_prompt": "Domain rules:\n- Dates: DD/MM/YYYY. NHS number: 'XXX XXX XXXX' with spaces. UBRN: 'XXXX-XXXX-XXXX'.\n- address / practice_address: street address only, WITHOUT the postcode (postcode goes in its own field). Hb is a number only (no units).\n- The condition flags (leukaemia, lymphadenopathy, myeloma, splenomegaly) are the ticked suspicion boxes on the referral; suspected_pathway is the named suspected condition (e.g. 'myeloma', 'acute leukaemia').\n- symptoms and myeloma_features are lists of the individual items stated, using the letter's own wording (e.g. 'Itching', 'Bruising/Bleeding', 'Renal impairment').\n- discussed_with_patient: 'Y' or 'N'.",
  "groups": {
    "Patient": ["title", "first_name", "surname", "sex", "date_of_birth", "nhs_number",
                "address", "postcode", "home_telephone", "mobile", "language", "ethnicity"],
    "Referral": ["referral_date", "ubrn", "referring_gp", "practice", "practice_address",
                 "practice_postcode", "practice_telephone", "hospital", "trust"],
    "Clinical": ["suspected_pathway", "leukaemia", "lymphadenopathy", "myeloma",
                 "splenomegaly", "lymph_node_size_cm", "lymph_node_site", "symptoms",
                 "myeloma_features", "investigations", "medical_history", "comments",
                 "discussed_with_patient"],
    "FBC": ["fbc"]
  },
  "fields": {
    "title": {"type": "str", "description": "Patient title: Mr/Mrs/Ms/Miss/Dr etc."},
    "first_name": {"type": "str"},
    "surname": {"type": "str", "critical": true},
    "sex": {"type": "str", "description": "'M' or 'F'",
            "pattern": "^[MF]$", "hint": "expected 'M' or 'F'"},
    "date_of_birth": {"type": "str", "description": "DD/MM/YYYY", "critical": true,
                      "pattern": "^\\d{2}/\\d{2}/\\d{4}$", "hint": "expected DD/MM/YYYY"},
    "nhs_number": {"type": "str", "description": "Format 'XXX XXX XXXX' with spaces",
                   "critical": true,
                   "pattern": "^\\d{3} \\d{3} \\d{4}$", "hint": "expected 'XXX XXX XXXX'"},
    "address": {"type": "str", "description": "Street address WITHOUT postcode"},
    "postcode": {"type": "str",
                 "pattern": "^[A-Z]{1,2}\\d[A-Z\\d]? ?\\d[A-Z]{2}$",
                 "hint": "not a valid UK postcode"},
    "home_telephone": {"type": "str"},
    "mobile": {"type": "str"},
    "language": {"type": "str", "description": "Patient's main spoken language"},
    "ethnicity": {"type": "str"},
    "referral_date": {"type": "str", "description": "DD/MM/YYYY",
                      "pattern": "^\\d{2}/\\d{2}/\\d{4}$", "hint": "expected DD/MM/YYYY"},
    "ubrn": {"type": "str", "description": "e-Referral booking reference, 'XXXX-XXXX-XXXX'",
             "pattern": "^\\d{4}-\\d{4}-\\d{4}$", "hint": "expected 'XXXX-XXXX-XXXX'"},
    "referring_gp": {"type": "str", "description": "Including title, e.g. 'Dr Naveen Malik'"},
    "practice": {"type": "str"},
    "practice_address": {"type": "str", "description": "Street address WITHOUT postcode"},
    "practice_postcode": {"type": "str",
                          "pattern": "^[A-Z]{1,2}\\d[A-Z\\d]? ?\\d[A-Z]{2}$",
                          "hint": "not a valid UK postcode"},
    "practice_telephone": {"type": "str"},
    "hospital": {"type": "str"},
    "trust": {"type": "str"},
    "suspected_pathway": {"type": "str", "critical": true,
                          "description": "e.g. 'myeloma', 'acute leukaemia', 'lymphoma'"},
    "leukaemia": {"type": "bool"},
    "lymphadenopathy": {"type": "bool"},
    "myeloma": {"type": "bool"},
    "splenomegaly": {"type": "bool"},
    "lymph_node_size_cm": {"type": "str"},
    "lymph_node_site": {"type": "str"},
    "fbc": {"type": "object", "fields": {
      "wbc": {"type": "str", "description": "White blood cell count, e.g. '3.4'"},
      "hb": {"type": "str", "description": "Haemoglobin in g/L, number only, e.g. '102'"},
      "platelets": {"type": "str", "description": "Platelet count, e.g. '88'"},
      "neutrophils": {"type": "str", "description": "Neutrophil count, e.g. '0.9'"},
      "lymphocytes": {"type": "str", "description": "Lymphocyte count, e.g. '0.6'"}
    }},
    "symptoms": {"type": "list[str]"},
    "myeloma_features": {"type": "list[str]"},
    "investigations": {"type": "str"},
    "medical_history": {"type": "str"},
    "comments": {"type": "str"},
    "discussed_with_patient": {"type": "str", "description": "'Y' or 'N'",
                               "pattern": "^[YN]$", "hint": "expected 'Y' or 'N'"}
  }
}
