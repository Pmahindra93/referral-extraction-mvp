{
  "name": "generic_referral",
  "display_name": "Generic referral (any specialty)",
  "document_description": "a clinical referral letter of any specialty (a clinician referring a patient to another service)",
  "domain_prompt": "Domain rules:\n- Dates: DD/MM/YYYY. NHS number: 'XXX XXX XXXX' with spaces if present.\n- address: street address only, WITHOUT the postcode.\n- specialty is the service being referred TO (e.g. 'cardiology', 'dermatology', 'physiotherapy').\n- urgency: use the letter's own framing, e.g. 'routine', 'urgent', '2WW'.\n- reason_for_referral: the clinical question or problem, briefly, in the letter's wording.",
  "groups": {
    "Patient": ["title", "first_name", "surname", "sex", "date_of_birth", "nhs_number",
                "address", "postcode", "telephone"],
    "Referral": ["referral_date", "referring_clinician", "practice_or_hospital",
                 "specialty", "destination", "urgency"],
    "Clinical": ["reason_for_referral", "symptoms", "medical_history", "medications",
                 "allergies", "investigations", "comments"]
  },
  "fields": {
    "title": {"type": "str", "description": "Patient title: Mr/Mrs/Ms/Miss/Dr etc."},
    "first_name": {"type": "str"},
    "surname": {"type": "str", "critical": true},
    "sex": {"type": "str", "description": "'M' or 'F'",
            "pattern": "^[MF]$", "hint": "expected 'M' or 'F'"},
    "date_of_birth": {"type": "str", "description": "DD/MM/YYYY", "critical": true,
                      "pattern": "^\\d{2}/\\d{2}/\\d{4}$", "hint": "expected DD/MM/YYYY"},
    "nhs_number": {"type": "str", "description": "Format 'XXX XXX XXXX' with spaces, if present",
                   "pattern": "^\\d{3} \\d{3} \\d{4}$", "hint": "expected 'XXX XXX XXXX'"},
    "address": {"type": "str", "description": "Street address WITHOUT postcode"},
    "postcode": {"type": "str",
                 "pattern": "^[A-Z]{1,2}\\d[A-Z\\d]? ?\\d[A-Z]{2}$",
                 "hint": "not a valid UK postcode"},
    "telephone": {"type": "str", "description": "Any patient phone number(s)"},
    "referral_date": {"type": "str", "description": "DD/MM/YYYY",
                      "pattern": "^\\d{2}/\\d{2}/\\d{4}$", "hint": "expected DD/MM/YYYY"},
    "referring_clinician": {"type": "str", "description": "Who is referring, including title"},
    "practice_or_hospital": {"type": "str", "description": "Where the referrer works"},
    "specialty": {"type": "str", "critical": true,
                  "description": "Service being referred to, e.g. 'cardiology'"},
    "destination": {"type": "str", "description": "Hospital/service the patient is referred to"},
    "urgency": {"type": "str", "description": "e.g. 'routine', 'urgent', '2WW'"},
    "reason_for_referral": {"type": "str", "critical": true,
                            "description": "The clinical question or problem, briefly"},
    "symptoms": {"type": "list[str]"},
    "medical_history": {"type": "str"},
    "medications": {"type": "str"},
    "allergies": {"type": "str"},
    "investigations": {"type": "str"},
    "comments": {"type": "str"}
  }
}
